{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrnwebdesigns.com/schemas/stack-release-lock.schema.json",
  "title": "MRN Stack Release Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "released_at",
    "source",
    "stack_version",
    "hash_algorithm",
    "compatibility",
    "components",
    "themes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "released_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "stack_version": {"type": "string", "minLength": 1},
    "hash_algorithm": {"const": "sha256-tree-v1"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_loader_version", "runtime_report_schema_version"],
      "properties": {
        "minimum_loader_version": {"type": "string", "minLength": 1},
        "runtime_report_schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/theme"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "hashFields": {
      "type": "object",
      "required": ["sha256", "file_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "version",
        "runtime_type",
        "required",
        "deployed_path",
        "source",
        "sha256",
        "file_count"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "runtime_type": {"enum": ["mu-loader", "mu-component", "standard-plugin"]},
        "required": {"const": true},
        "deployed_path": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "version",
        "active",
        "verification_mode",
        "deployed_path",
        "source",
        "sha256",
        "file_count"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "version": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "verification_mode": {"enum": ["exact", "site-derived"]},
        "deployed_path": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
