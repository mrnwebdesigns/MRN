{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrnwebdesigns.com/schemas/optional-plugin-update-plan.schema.json",
  "title": "MRN One-Site Optional Plugin Update Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_type", "plan_id", "generated_at", "plugin", "site", "operation", "preflight", "execution_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_type": {"const": "optional-plugin-update"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "target_version", "target_tier", "current_distribution", "source", "package"],
      "properties": {
        "slug": {"type": "string", "pattern": "^mrn-[a-z0-9-]+$"},
        "target_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "target_tier": {"type": "string", "not": {"const": "platform-required"}},
        "current_distribution": {"const": "catalog-only"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "git_commit"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "filename", "main_file", "size_bytes", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"},
            "main_file": {"type": "string", "minLength": 1},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "site_url", "inventory_synced_at", "inventory_age_seconds", "installed", "active", "current_version", "target_version"],
      "properties": {
        "site_id": {"type": "integer", "minimum": 1},
        "site_url": {"type": "string", "format": "uri"},
        "inventory_synced_at": {"type": "string", "format": "date-time"},
        "inventory_age_seconds": {"type": "integer", "minimum": 0},
        "installed": {"const": true},
        "active": {"type": "boolean"},
        "current_version": {"type": "string"},
        "target_version": {"type": "string"}
      }
    },
    "operation": {"const": "upgrade-only"},
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "package_sha256", "backup_readiness", "rollback_readiness", "blockers"],
      "properties": {
        "ready": {"const": true},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "backup_readiness": {
          "type": "object",
          "required": ["ready", "provider", "remote_destination_configured", "wp_cli_available", "backup_command_available"],
          "properties": {
            "ready": {"const": true},
            "provider": {"type": "string", "minLength": 1},
            "remote_destination_configured": {"const": true},
            "wp_cli_available": {"const": true},
            "backup_command_available": {"const": true}
          }
        },
        "rollback_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "version", "package_path", "package_filename", "main_file", "size_bytes", "package_sha256"],
          "properties": {
            "ready": {"const": true},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "package_path": {"type": "string", "minLength": 1},
            "package_filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"},
            "main_file": {"type": "string", "minLength": 1},
            "size_bytes": {"type": "integer", "minimum": 1},
            "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "blockers": {"type": "array", "maxItems": 0}
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_ability", "controller_ability", "rollback_ability", "minimum_controller_version", "precondition_hash_source", "rollback_artifact_model", "allow_new_install", "preserve_active_state", "requires_fresh_inventory_recheck", "requires_confirm", "requires_fresh_database_backup_receipt", "requires_precondition_hash"],
      "properties": {
        "preflight_ability": {"const": "mrn-mainwp/preflight-optional-plugin-update-v1"},
        "controller_ability": {"const": "mrn-mainwp/update-optional-plugin-v1"},
        "rollback_ability": {"const": "mrn-mainwp/rollback-optional-plugin-v1"},
        "minimum_controller_version": {"const": "0.8.2"},
        "precondition_hash_source": {"const": "controller-preflight"},
        "rollback_artifact_model": {"const": "operator-supplied-checksum-locked-package"},
        "allow_new_install": {"const": false},
        "preserve_active_state": {"const": true},
        "requires_fresh_inventory_recheck": {"const": true},
        "requires_confirm": {"const": true},
        "requires_fresh_database_backup_receipt": {"const": true},
        "requires_precondition_hash": {"const": true}
      }
    }
  }
}
