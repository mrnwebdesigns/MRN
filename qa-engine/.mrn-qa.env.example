# Project-local overrides for MRN QA Engine
MRN_QA_PROFILE=wordpress-site
MRN_QA_SCOPE=site-only
MRN_QA_APPROVED_REF_MODE=auto
MRN_QA_RUN_SMOKE=auto
MRN_SMOKE_SCOPE=public
MRN_SMOKE_STRICT=0
MRN_QA_FAIL_ON_THEME_ADVISORY=0
MRN_QA_PLAYWRIGHT_PROVIDER=engine
# Optional ignore patterns for known noisy runtime errors/asset failures
# MRN_QA_PLAYWRIGHT_IGNORE_REGEX=owl\\.carousel\\.css,slick-init\\.js

# Optional explicit release reference
# MRN_QA_APPROVED_REF=main

# Optional explicit paths
# MRN_QA_SITE_PATH=/Users/khofmeyer/Local Sites/freedomhouse/app/public
# MRN_QA_SITE_URL=http://freedomhouse.local
# MRN_QA_STACK_ROOT=/Users/khofmeyer/Development/MRN
