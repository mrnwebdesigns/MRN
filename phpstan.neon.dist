includes:
    - phpstan-baseline.neon

parameters:
    level: 3
    paths: []
    tmpDir: .tmp/phpstan
    bootstrapFiles:
        - phpstan-bootstrap.php
    stubFiles:
        - tools/phpstan/nav-menu-items.stub
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - stack/themes/mrn-base-stack/functions.php
        - stack/themes/mrn-base-stack/inc/display-styles.php
        - stack/themes/mrn-base-stack/inc/row-spacing-meta.php
        - stack/themes/mrn-base-stack/inc/admin-acf-assets.php
        - stack/themes/mrn-base-stack/inc/image-helpers.php
        - stack/themes/mrn-base-stack/inc/builder/render.php
        - stack/themes/mrn-base-stack/inc/cookie-preferences.php
        - mu-plugins/mrn-public-security-hardening/mrn-public-security-hardening.php
    parallel:
        maximumNumberOfProcesses: 1
        jobSize: 20
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    excludePaths:
        # Test fixtures redefine WordPress globals and execute in separate processes.
        analyseAndScan:
            - */tests/*
            # Component QA caches contain generated PHP, not deployable source.
            - */build/phpstan/*
            - */.tmp/phpstan/*
        analyse:
            - */vendor/*
            - */node_modules/*
            - */playwright-report/*
            - */test-results/*
            - .git/*
            - .local/*
            - .tmp/*
            - releases/*
            - stack/mu-plugins/*
