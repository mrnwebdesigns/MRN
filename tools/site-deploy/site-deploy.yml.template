name: Deploy site

on:
  workflow_run:
    workflows: [MRN source push]
    types: [completed]
  workflow_dispatch:
    inputs:
      target:
        description: Destination
        type: choice
        options: [dev, live, both]
        default: dev
        required: true
      mode:
        description: Read-only preflight or authorized deployment
        type: choice
        options: [preflight, deploy]
        default: preflight
        required: true
      source_branch:
        description: Same-repository branch (Dev only); Live/Both require main
        type: string
        default: main
        required: true

permissions:
  contents: read

jobs:
  deploy:
    uses: mrnwebdesigns/MRN/.github/workflows/site-deploy.yml@TOOLING_SHA
    with:
      tooling_ref: TOOLING_SHA
      source_path: SOURCE_PATH
      stylesheet: THEME_SLUG
      target: ${{ inputs.target || 'dev' }}
      mode: ${{ inputs.mode || 'deploy' }}
      source_branch: ${{ inputs.source_branch || 'main' }}
      release_requests_after: ${{ vars.MRN_RELEASE_REQUESTS_AFTER }}
      live_enabled: true
      auto_dev_branch: main
      auto_dev_after: ${{ vars.MRN_AUTO_DEV_AFTER }}
    secrets: inherit
