name: Deploy site
run-name: "${{ inputs.qualify_dev && format('MRN Dev qualification {0}', inputs.enrollment_id) || 'Deploy site' }}"

on:
  workflow_run:
    workflows: [MRN source push]
    types: [completed]
  workflow_dispatch:
    inputs:
      target:
        description: Destination
        type: choice
        options: [dev, staging, live, both]
        default: dev
        required: true
      mode:
        description: Read-only target preflight, source-and-artifact qualification, or authorized deployment
        type: choice
        options: [preflight, qualify, deploy]
        default: preflight
        required: true
      qualify_dev:
        description: Operator-only first Dev qualification
        type: boolean
        default: false
      enrollment_id:
        description: Operator enrollment correlation ID
        type: string
        default: ''
      source_branch:
        description: Same-repository branch for Dev. Staging, Live and Both require main
        type: string
        default: main
        required: true
      promotion_evidence_id:
        description: Optional GitHub Dev or staging evidence artifact ID for Live
        type: string
        default: ''

permissions:
  contents: read
  actions: read
  statuses: write

jobs:
  deploy:
    uses: mrnwebdesigns/MRN/.github/workflows/site-deploy.yml@TOOLING_SHA
    with:
      tooling_ref: TOOLING_SHA
      source_path: SOURCE_PATH
      stylesheet: THEME_SLUG
      target: ${{ inputs.target || 'dev' }}
      mode: ${{ inputs.mode || 'deploy' }}
      source_branch: ${{ inputs.source_branch || 'main' }}
      promotion_evidence_id: ${{ inputs.promotion_evidence_id || '' }}
      release_requests_after: ${{ vars.MRN_RELEASE_REQUESTS_AFTER }}
      live_enabled: true
      qualify_dev: ${{ inputs.qualify_dev || false }}
      auto_dev_branch: main
      auto_dev_after: ${{ vars.MRN_AUTO_DEV_AFTER }}
      qualify_main: true
    secrets: inherit
