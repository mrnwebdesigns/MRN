# MRN Apps uses Nginx. Install only this new vhost after issuing its certificate.
# Use the existing /var/www/certbot webroot for the separate ACME HTTP bootstrap.
server {
    listen 80;
    listen [::]:80;
    server_name operations.mrnwebdesigns.com;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }
    location / { return 301 https://operations.mrnwebdesigns.com$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name operations.mrnwebdesigns.com;
    ssl_certificate /etc/letsencrypt/live/operations.mrnwebdesigns.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/operations.mrnwebdesigns.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    access_log off;

    # Exact routes avoid publishing files, unrelated apps or an admin surface.
    location ~ ^/(mcp|healthz|\.well-known/oauth-protected-resource(?:/mcp)?)$ {
        proxy_pass http://127.0.0.1:8812;
        proxy_http_version 1.1;
        proxy_set_header Host operations.mrnwebdesigns.com;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 720s;
    }
    location / { return 404; }
}
