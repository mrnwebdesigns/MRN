  "invariants": [
    "Context.binding and management_context_sha256 must match the independently opened immutable original job; no worker-selected identity, source, target, run, artifact, URL or key.",
    "Capture and original measurement-record digests are independently recomputed from their retained encrypted bytes; all eight evidence references resolve to the same acquired binary archive and QA-signed manifest.",
    "One acquisition claim and one immutable encrypted slot per original job; uncertain writes never retry, overwrite, recreate a job or renew its expiry. Read recovery observes only a complete existing slot.",
    "Current original Google principal, active Directory status, role, authorization/source/evidence-policy epochs and fresh management veto are rechecked before and after network/parsing and under ordered final atomic CAS. An independent readback connection cannot commit the outer transaction.",
    "Signatures, schema, synthetic vectors and successful parsing alone confer no authority. No ability is registered until independent authenticated acquisition and native retention/readback proof exist.",
    "Retention neither issues a profile/consumer binding nor changes production qualification, target revision, mutation approval, QA receipt or backup requirements. Creation ID0 is unsupported in this contract."
  ],
  "qualification_protocol": "content-management-existing-v2",
  "runtime_registered": false,
  "compatibility_baseline_sha256": {
    "content-management-qualification-v1.json": "7c0cd9e6f431f47580f9926e8d228728034f20b71d581c8dfb00b32dcb4f4f91"
  },
  "native_adapter": "content-management-v1"
}
