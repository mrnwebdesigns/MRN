    "site_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "site_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "target": {
      "type": "object",
      "properties": {
