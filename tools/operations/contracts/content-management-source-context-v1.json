{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrn.example.invalid/content-management-source-context-v1.json",
  "schema_version": 1,
  "review_state": "source-only-not-production-qualified",
  "source_transfer_contract_sha256": "36320f6d2d5dac5523ecc68b0fa463c2fa1246cbf75f81e3209c055aa196f3e9",
  "purpose": "mrn-content-management-source-context-v1:",
  "private_ability": "mrn-mainwp/read-content-edit-qualification-source-context-v1",
  "limits": {
    "request_bytes": 16384,
    "claims_bytes": 8192,
    "response_bytes": 32768,
    "lookup_deadline_seconds": 20,
    "maximum_signed_request_ttl_seconds": 300,
    "maximum_context_reads_per_original": 2
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "site_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "site_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^https://[a-z0-9.-]+\\.example\\.invalid(?:/[A-Za-z0-9._~%/@:+-]+)*$"
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wordpress-content"
          ]
        },
        "post_type": {
          "type": "string",
          "maxLength": 4,
          "enum": [
            "post",
            "page"
          ]
        },
        "post_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "post_type",
        "post_id"
      ],
      "additionalProperties": false
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "adapter": {
          "type": "string",
          "enum": [
            "content-management-v1"
          ]
        },
        "qualification_job_id": {
          "$ref": "#/$defs/uuid"
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "reviewed_digest": {
          "$ref": "#/$defs/hash"
        },
        "requester_binding_sha256": {
          "$ref": "#/$defs/hash"
        },
        "authorization_policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "site_id": {
          "$ref": "#/$defs/site_id"
        },
        "site_url": {
          "$ref": "#/$defs/site_url"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_target_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "before_sha256": {
          "$ref": "#/$defs/hash"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/hash"
        },
        "request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "migration_sha256": {
          "$ref": "#/$defs/hash"
        },
        "profile_sha256": {
          "$ref": "#/$defs/hash"
        },
        "runtime_context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "acf_schema_sha256": {
          "$ref": "#/$defs/hash"
        },
        "management_contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "provider_source_sha": {
          "$ref": "#/$defs/source_sha"
        },
        "installed_manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_binding_sha256": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "before_paths_sha256": {
          "$ref": "#/$defs/hash"
        },
        "job_intent_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        }
      },
      "required": [
        "schema",
        "adapter",
        "qualification_job_id",
        "operation_id",
        "reviewed_digest",
        "requester_binding_sha256",
        "authorization_policy_sha256",
        "site_id",
        "site_url",
        "target",
        "expected_target_revision",
        "before_sha256",
        "candidate_sha256",
        "request_sha256",
        "migration_sha256",
        "profile_sha256",
        "runtime_context_sha256",
        "acf_schema_sha256",
        "management_contract_sha256",
        "provider_source_sha",
        "installed_manifest_sha256",
        "source_binding_sha256",
        "created_at",
        "expires_at",
        "before_paths_sha256",
        "job_intent_ttl_seconds"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10924,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "signature_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "key_id",
        "payload_base64",
        "signature_base64"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "management_context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "capture_artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "measurement_record_sha256": {
          "$ref": "#/$defs/hash"
        },
        "parity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evidence_policy_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evidence_policy_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "binding",
        "management_context_sha256",
        "capture_artifact_sha256",
        "measurement_record_sha256",
        "parity_sha256",
        "evidence_policy_epoch",
        "evidence_policy_sha256"
      ],
      "additionalProperties": false
    },
    "source_context": {
      "type": "object",
      "properties": {
        "management": {
          "$ref": "#/$defs/context"
        },
        "source_recipe_catalog_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "management",
        "source_recipe_catalog_sha256"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "issuer": {
          "type": "string",
          "enum": [
            "mrn-content-qualification"
          ]
        },
        "audience": {
          "type": "string",
          "enum": [
            "https://wpcontrol.mrndev.io"
          ]
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "nonce": {
          "$ref": "#/$defs/hash"
        },
        "action": {
          "type": "string",
          "enum": [
            "read-management-source-context"
          ]
        },
        "qualification_job_id": {
          "$ref": "#/$defs/uuid"
        },
        "management_context_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "issuer",
        "audience",
        "issued_at",
        "expires_at",
        "request_id",
        "nonce",
        "action",
        "qualification_job_id",
        "management_context_sha256"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "signed_request": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "signed_request"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "source_context": {
          "$ref": "#/$defs/source_context"
        },
        "source_context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_bytes_verified": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "slot_created": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "admitted": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "request_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "schema",
        "source_context",
        "source_context_sha256",
        "source_bytes_verified",
        "slot_created",
        "admitted",
        "request_sha256"
      ],
      "additionalProperties": false
    }
  }
}
